  "nodes": [
    {
      "id": "n_start",
      "type": "start",
      "x": 80,
      "y": 120,
      "data": {
        "label": "Day 1 · Event I"
      }
    },
    {
      "id": "intro_lizz",
      "type": "dialogue",
      "x": 440,
      "y": 120,
      "data": {
        "speaker": "Lizz",
        "text": "Good morning, Matt. Another quiet morning... There is a new notification on your computer. You have not received a friend request since that incident. Maybe you should check it out?"
      }
    },
    {
      "id": "ev1_request",
      "type": "choice",
      "x": 800,
      "y": 120,
      "data": {
        "prompt": "Friend request from Adam: would you give him a chance to talk about George's birthday?",
        "options": [
          {
            "id": "ev1_accept",
            "text": "Accept the request",
            "effects": []
          },
          {
            "id": "ev1_decline",
            "text": "Decline",
            "effects": []
          }
        ]
      }
    },
    {
      "id": "ev1_decline_lizz",
      "type": "dialogue",
      "x": 1160,
      "y": 120,
      "data": {
        "speaker": "Lizz",
        "text": "Perhaps it is better to keep you in the dark after all."
      }
    },
    {
      "id": "ev1_decline_system",
      "type": "dialogue",
      "x": 1520,
      "y": 120,
      "data": {
        "speaker": "System",
        "text": "> SYSTEM OVERRIDE\n> ACCESSING NEURAL INTERFACE\n> INITIATING TERMINAL SHUTDOWN"
      }
    },
    {
      "id": "end_hidden",
      "type": "end",
      "x": 1880,
      "y": 120,
      "data": {
        "label": "Hidden Ending · Kept in the Dark",
        "ending": "Hidden Ending · Kept in the Dark"
      }
    },
    {
      "id": "ev1_adam_1",
      "type": "dialogue",
      "x": 2240,
      "y": 120,
      "data": {
        "speaker": "Adam",
        "text": "Matt, thanks for accepting. George's birthday is coming up. Maybe we could surprise him, like we used to."
      }
    },
    {
      "id": "ev1_reply_1",
      "type": "choice",
      "x": 2600,
      "y": 120,
      "data": {
        "prompt": "How do you answer? (Event I has no affinity change.)",
        "options": [
          {
            "id": "ev1_r1_a",
            "text": "So, what do you want to say?",
            "effects": []
          },
          {
            "id": "ev1_r1_b",
            "text": "Why suddenly throw a party?",
            "effects": []
          },
          {
            "id": "ev1_r1_c",
            "text": "...",
            "effects": []
          }
        ]
      }
    },
    {
      "id": "ev1_adam_2",
      "type": "dialogue",
      "x": 80,
      "y": 360,
      "data": {
        "speaker": "Adam",
        "text": "I know what happened made you angry. Maybe we were all too stubborn. George has not been doing well, and this could be a chance to repair things."
      }
    },
    {
      "id": "ev1_reply_2",
      "type": "choice",
      "x": 440,
      "y": 360,
      "data": {
        "prompt": "Adam waits for your answer.",
        "options": [
          {
            "id": "ev1_r2_a",
            "text": "Why contact me now?",
            "effects": []
          },
          {
            "id": "ev1_r2_b",
            "text": "Are you sure George wants this?",
            "effects": []
          },
          {
            "id": "ev1_r2_c",
            "text": "Go on.",
            "effects": []
          }
        ]
      }
    },
    {
      "id": "ev1_adam_3",
      "type": "dialogue",
      "x": 800,
      "y": 360,
      "data": {
        "speaker": "Adam",
        "text": "I will send the plans. We need to discuss the venue and theme. Thank you for being part of this, Matt."
      }
    },
    {
      "id": "complete_ev1",
      "type": "setvar",
      "x": 1160,
      "y": 360,
      "data": {
        "assignments": [
          {
            "var": "completed_event_1",
            "op": "set",
            "value": "true"
          }
        ]
      }
    },
    {
      "id": "free_d1_afternoon",
      "type": "choice",
      "x": 1520,
      "y": 360,
      "data": {
        "prompt": "Day 1 afternoon · Free exploration. One item may be examined.",
        "options": [
          {
            "id": "free_napkin",
            "text": "Examine one of the tErminaL napkins",
            "effects": [
              {
                "var": "found_napkin",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_departure",
            "text": "Read George's departure report",
            "effects": [
              {
                "var": "read_departure",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_lakeside",
            "text": "Open George's profile and notice the lakeside cabin",
            "effects": [
              {
                "var": "saw_lakeside",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_skip_1",
            "text": "Rest without examining an item",
            "effects": []
          }
        ]
      }
    },
    {
      "id": "free_d1_evening",
      "type": "choice",
      "x": 1880,
      "y": 360,
      "data": {
        "prompt": "Day 1 evening · Free exploration. One item may be examined.",
        "options": [
          {
            "id": "free_pc",
            "text": "Examine George's carefully preserved Apple II",
            "effects": [
              {
                "var": "found_vintage_pc",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_photo",
            "text": "Examine the founders' 1999 basement photograph",
            "effects": [
              {
                "var": "saw_old_photos",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_napkin_2",
            "text": "Examine another tErminaL napkin",
            "effects": [
              {
                "var": "found_napkin",
                "op": "set",
                "value": "true"
              }
            ]
          },
          {
            "id": "free_skip_2",
            "text": "Let the evening pass",
            "effects": []
          }
        ]
      }
    },
    {
      "id": "ev2_intro",
      "type": "dialogue",
      "x": 2240,
      "y": 360,
      "data": {
        "speaker": "Adam",
        "text": "Hey Matt, we need to think carefully about the party venue. This means a lot to George. Any suggestions?"
      }
    },
    {
      "id": "ev2_venue",
      "type": "choice",
      "x": 2600,
      "y": 360,
      "data": {
        "prompt": "Choose a venue.",
        "options": [
          {
            "id": "ev2_restaurant",
            "text": "The Terminal restaurant",
            "effects": []
          },
          {
            "id": "ev2_office",
            "text": "The Metaplace office",
            "effects": []
          },
          {
            "id": "ev2_quiet",
            "text": "Somewhere quiet",
            "effects": []
          }
        ]
      }
    },
    {
