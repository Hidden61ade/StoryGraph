    {
      "id": "ev3_memory",
      "type": "choice",
      "x": 800,
      "y": 1080,
      "data": {
        "prompt": "Adam: Do you remember our first promise?",
        "options": [
          {
            "id": "ev3_remember",
            "text": "At The Terminal, we promised to change the world.",
            "effects": []
          },
          {
            "id": "ev3_forget",
            "text": "Sorry, I do not remember.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev3_special",
      "type": "dialogue",
      "x": 1160,
      "y": 1080,
      "data": {
        "speaker": "Adam",
        "text": "I cannot believe you remember. We thought we could create a perfect world."
      }
    },
    {
      "id": "ev3_critical",
      "type": "choice",
      "x": 1520,
      "y": 1080,
      "data": {
        "prompt": "What does that promise mean now?",
        "options": [
          {
            "id": "ev3_critical_a",
            "text": "Maybe we did create something.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "2"
              }
            ]
          },
          {
            "id": "ev3_critical_b",
            "text": "Does any of it matter now?",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          },
          {
            "id": "ev3_critical_c",
            "text": "Let this party be a new beginning.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev3_outro",
      "type": "dialogue",
      "x": 1880,
      "y": 1080,
      "data": {
        "speaker": "Adam",
        "text": "Theme settled. I think George will like it."
      }
    },
