    {
      "id": "ev3_retro_detail",
      "type": "choice",
      "x": 2240,
      "y": 840,
      "data": {
        "prompt": "Use the old computer clue.",
        "options": [
          {
            "id": "ev3_retro_a",
            "text": "George kept his first computer; he will love this.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "2"
              }
            ]
          },
          {
            "id": "ev3_retro_b",
