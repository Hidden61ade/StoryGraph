                "var": "affection_adam",
                "op": "add",
                "value": "1"
              }
            ]
          },
          {
            "id": "ev2_office_b",
            "text": "What exactly happened?",
            "effects": []
          },
          {
            "id": "ev2_office_c",
            "text": "Then choose somewhere else.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev2_quiet_detail",
      "type": "choice",
      "x": 1880,
      "y": 600,
      "data": {
        "prompt": "Adam: Do you have somewhere specific in mind?",
