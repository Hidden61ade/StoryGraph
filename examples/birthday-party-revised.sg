    },
    {
      "id": "ev3_family_detail",
      "type": "choice",
      "x": 2600,
      "y": 840,
      "data": {
        "prompt": "Use the old photograph clue.",
        "options": [
          {
            "id": "ev3_family_a",
            "text": "Like our first party in your basement.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "2"
              }
            ]
          },
          {
            "id": "ev3_family_b",
            "text": "It has been a while since we gathered.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "1"
              }
            ]
          },
          {
            "id": "ev3_family_c",
            "text": "Just keep it simple.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev3_theme_neutral",
