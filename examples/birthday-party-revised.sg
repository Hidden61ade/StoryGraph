          },
          {
            "id": "ev2_quiet_b",
            "text": "Maybe a cafe.",
            "effects": []
          },
          {
            "id": "ev2_quiet_c",
            "text": "You decide.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev2_no_clue",
      "type": "dialogue",
      "x": 2240,
      "y": 600,
      "data": {
        "speaker": "Adam",
        "text": "We do not have enough information to make that suggestion convincing. I will keep looking."
      }
    },
    {
      "id": "ev2_outro",
      "type": "dialogue",
      "x": 2600,
      "y": 600,
      "data": {
        "speaker": "Adam",
        "text": "All right, I have noted it. We will talk about the theme later. Thanks, Matt."
      }
    },
    {
      "id": "complete_ev2",
