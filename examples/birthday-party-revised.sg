      "type": "dialogue",
      "x": 440,
      "y": 840,
      "data": {
        "speaker": "Lizz",
        "text": "Day 2 afternoon · Free time. Cycle 1 explores ordinary files; cycle 2 reveals contradictions; cycle 3 exposes the loop."
      }
    },
    {
      "id": "ev3_intro",
      "type": "dialogue",
      "x": 800,
      "y": 840,
      "data": {
        "speaker": "Adam",
        "text": "Matt, about the party theme... We need something special. It is George's birthday after all."
      }
