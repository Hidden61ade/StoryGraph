    {
      "id": "ev2_restaurant_detail",
      "type": "choice",
      "x": 1160,
      "y": 600,
      "data": {
        "prompt": "Adam: You mean The Terminal restaurant?",
        "options": [
          {
            "id": "ev2_rest_a",
            "text": "Our idea started there.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "2"
              }
            ]
          },
          {
            "id": "ev2_rest_b",
            "text": "It had a good atmosphere.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "add",
                "value": "1"
              }
            ]
          },
          {
            "id": "ev2_rest_c",
            "text": "Any restaurant will do.",
            "effects": [
              {
                "var": "affection_adam",
                "op": "sub",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ev2_office_detail",
      "type": "choice",
      "x": 1520,
      "y": 600,
      "data": {
        "prompt": "Adam: George hardly goes to the office since leaving management.",
        "options": [
          {
            "id": "ev2_office_a",
            "text": "Sorry, I forgot about that.",
